APP_NAME="Phong kham Nhom 3"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=phong_kham_nhom3
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@phongkham.test"
MAIL_FROM_NAME="${APP_NAME}"

CLINIC_CANCELLATION_HOURS=24
CLINIC_BOOKING_STATUS=PENDING
CLINIC_CONSULTATION_FEE=200000
# MySQL on Laragon: change DB_CONNECTION=mysql and uncomment DB_* above.
# Start MySQL in Laragon before running setup.ps1.
# MYSQLDUMP_PATH=D:/laragon/bin/mysql/mysql-8.0.30-winx64/bin/mysqldump.exe
# MYSQL_PATH=D:/laragon/bin/mysql/mysql-8.0.30-winx64/bin/mysql.exe
