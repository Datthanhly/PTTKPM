digraph ERD {
graph [rankdir=LR, nodesep=.35, ranksep=.48, pad=.12, splines=spline, outputorder=edgesfirst, bgcolor="white"];
node [shape=plain,fontname="Times New Roman"];
edge [color="#49635f",penwidth=.8,arrowsize=.65];
"branches" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>branches</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR></TABLE>>];
"integration_systems" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>integration_systems</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="branch_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  branch_id</FONT></TD></TR></TABLE>>];
"integration_messages" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>integration_messages</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="integration_system_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  integration_system_id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
"appointments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>appointments</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">status</FONT></TD></TR><TR><TD PORT="branch_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  branch_id</FONT></TD></TR></TABLE>>];
"notification_jobs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>notification_jobs</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="appointment_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  appointment_id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
"audit_logs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>audit_logs</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="branch_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  branch_id</FONT></TD></TR></TABLE>>];
"integration_systems":"branch_id":e -> "branches":"id":w;
"integration_messages":"integration_system_id":e -> "integration_systems":"id":w;
"appointments":"branch_id":e -> "branches":"id":w;
"notification_jobs":"appointment_id":e -> "appointments":"id":w;
