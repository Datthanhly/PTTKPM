"device_measurements" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>device_measurements</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="visit_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  visit_id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
