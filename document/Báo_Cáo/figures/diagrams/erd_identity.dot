digraph ERD {
graph [rankdir=LR, nodesep=.35, ranksep=.48, pad=.12, splines=spline, outputorder=edgesfirst, bgcolor="white"];
node [shape=plain,fontname="Times New Roman"];
edge [color="#49635f",penwidth=.8,arrowsize=.65];
"roles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>roles</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>users</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="role_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  role_id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
"branches" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>branches</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR></TABLE>>];
"branch_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>branch_user</B></FONT></TD></TR><HR/><TR><TD PORT="branch_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  branch_id</FONT></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  user_id</FONT></TD></TR></TABLE>>];
"user_permissions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>user_permissions</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  user_id</FONT></TD></TR><TR><TD PORT="branch_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  branch_id</FONT></TD></TR></TABLE>>];
"doctors" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>doctors</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  user_id</FONT></TD></TR><TR><TD PORT="specialty_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  specialty_id</FONT></TD></TR></TABLE>>];
"specialties" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>specialties</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR></TABLE>>];
"doctor_specialty" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>doctor_specialty</B></FONT></TD></TR><HR/><TR><TD PORT="doctor_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  doctor_id</FONT></TD></TR><TR><TD PORT="specialty_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  specialty_id</FONT></TD></TR></TABLE>>];
"users":"role_id":e -> "roles":"id":w;
"branch_user":"branch_id":e -> "branches":"id":w;
"branch_user":"user_id":e -> "users":"id":w;
"user_permissions":"branch_id":e -> "branches":"id":w;
