digraph ERD {
graph [rankdir=LR, nodesep=.35, ranksep=.48, pad=.12, splines=spline, outputorder=edgesfirst, bgcolor="white"];
node [shape=plain,fontname="Times New Roman"];
edge [color="#49635f",penwidth=.8,arrowsize=.65];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>users</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
"branches" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>branches</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR></TABLE>>];
"staff_schedule_requests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>staff_schedule_requests</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  user_id</FONT></TD></TR><TR><TD PORT="branch_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  branch_id</FONT></TD></TR><TR><TD PORT="work_date" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">work_date</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
"staff_work_shifts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>staff_work_shifts</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="request_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  request_id</FONT></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  user_id</FONT></TD></TR><TR><TD PORT="branch_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  branch_id</FONT></TD></TR><TR><TD PORT="work_date" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">work_date</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
"salary_profiles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>salary_profiles</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  user_id</FONT></TD></TR></TABLE>>];
"payroll_entries" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#47756e"><TR><TD BGCOLOR="#e9f3f2"><FONT FACE="Times New Roman" POINT-SIZE="14"><B>payroll_entries</B></FONT></TD></TR><HR/><TR><TD PORT="id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">PK  id</FONT></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">FK  user_id</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT FACE="Times New Roman" POINT-SIZE="12">status</FONT></TD></TR></TABLE>>];
"staff_schedule_requests":"branch_id":e -> "branches":"id":w;
"staff_schedule_requests":"user_id":e -> "users":"id":w;
"staff_work_shifts":"branch_id":e -> "branches":"id":w;
"staff_work_shifts":"request_id":e -> "staff_schedule_requests":"id":w;
"staff_work_shifts":"user_id":e -> "users":"id":w;
